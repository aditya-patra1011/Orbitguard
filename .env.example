# Copy to .env and fill in. .env is git-ignored and excluded from the Docker image.

# Required: the PostgreSQL password (Compose will not start without it).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Public deployment only:
# ORBITGUARD_PUBLIC=1          # refuse to start with weak settings
# ORBITGUARD_API_KEYS=         # comma-separated, 32+ characters each; needed for POST /risk/forecast
# ORBITGUARD_TRUST_PROXY=1     # behind the hosting platform's proxy, for per-client rate limits
# ORBITGUARD_RATE_LIMIT=120    # requests per minute per client (heavy endpoints get a tenth)
